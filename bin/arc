#!/usr/bin/env bash
#
# arc - AI-powered orchestration for multi-phase development tasks
#
# Usage: arc <command> [args...]
#
# Commands:
#   init                  Initialize arc in the current project
#   plan <name> [phases]  Create a new plan with phases
#   review <plan>         Run adversarial review on a plan
#   run <plan>            Execute a plan through the orchestrator
#   status [plan] [phase] Show plan/phase status
#   iterate <plan> <phase> [mode]  Run one iteration on a phase
#   monitor [plan]        Live TUI monitor for orchestration progress
#   update                Update arc to the latest version
#   help                  Show this help message
#
# Project config: .arc.yaml
# Plans directory: .plans/

set -euo pipefail

# Resolve ARC_HOME — where arc is installed
# Follow symlinks to find the real location
SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
ARC_HOME="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"
export ARC_HOME

# Project root is the current working directory
export ARC_PROJECT_ROOT="$(pwd)"
export ARC_PLANS_DIR="${ARC_PLANS_DIR:-$ARC_PROJECT_ROOT/.plans}"
export ARC_SCRIPTS_DIR="$ARC_HOME/scripts"

# Version
ARC_VERSION="0.1.0"

usage() {
    echo "arc v${ARC_VERSION} — AI-powered orchestration for multi-phase development"
    echo ""
    echo "Usage: arc <command> [args...]"
    echo ""
    echo "Commands:"
    echo "  init                       Initialize arc in the current project"
    echo "  plan <name> [--type TYPE] <phase1> [phase2] ...  Create a new plan"
    echo "  review <plan> [phase]      Run adversarial review committee"
    echo "  run <plan>                 Execute plan through orchestrator"
    echo "  status [plan] [phase]      Show plan/phase status"
    echo "  iterate <plan> <phase> [mode]  Run one iteration (qa|impl|fix|...)"
    echo "  monitor [plan]             Live TUI monitor for orchestration progress"
    echo "  update [--version TAG]     Update arc to latest (or specific version)"
    echo "  help                       Show this help"
    echo ""
    echo "Project config: .arc.yaml"
    echo "Plans: .plans/"
    echo ""
    echo "Getting started:"
    echo "  arc init                   # Set up arc in your project"
    echo "  arc plan my-feature p1 p2  # Create a plan with phases"
    echo "  arc review my-feature      # Review the plan"
    echo "  arc run my-feature         # Execute the plan"
}

COMMAND="${1:-help}"
shift 2>/dev/null || true

case "$COMMAND" in
    init)
        exec "$ARC_SCRIPTS_DIR/init-project.sh" "$@"
        ;;
    plan)
        exec "$ARC_SCRIPTS_DIR/init-plan.sh" "$@"
        ;;
    review)
        exec "$ARC_SCRIPTS_DIR/plan-review-loop.sh" "$@"
        ;;
    run)
        exec "$ARC_SCRIPTS_DIR/run-orchestrator.sh" "$@"
        ;;
    status)
        exec "$ARC_SCRIPTS_DIR/status.sh" "$@"
        ;;
    iterate)
        exec "$ARC_SCRIPTS_DIR/iterate.sh" "$@"
        ;;
    monitor)
        exec "$ARC_SCRIPTS_DIR/monitor-orchestrator.sh" "$@"
        ;;
    update)
        arc_update() {
            local target_version=""

            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --version|-V)
                        target_version="$2"
                        shift 2
                        ;;
                    --help|-h)
                        echo "Usage: arc update [--version TAG]"
                        echo ""
                        echo "Updates arc to the latest version, or a specific tagged version."
                        echo ""
                        echo "Options:"
                        echo "  --version, -V TAG   Update to a specific version tag (e.g., v0.2.0)"
                        return 0
                        ;;
                    *)
                        echo "Unknown option: $1" >&2
                        return 1
                        ;;
                esac
            done

            cd "$ARC_HOME"

            if [[ ! -d ".git" ]]; then
                echo "Error: arc was not installed via git. Cannot update." >&2
                echo "Re-install with: git clone <repo> ~/.arc" >&2
                return 1
            fi

            local before
            before=$(git rev-parse HEAD)

            echo "Updating arc..."
            git fetch --tags --quiet origin

            if [[ -n "$target_version" ]]; then
                if ! git rev-parse "$target_version" &>/dev/null; then
                    echo "Error: version '$target_version' not found." >&2
                    echo "Available versions:"
                    git tag --sort=-v:refname | head -10
                    return 1
                fi
                git checkout --quiet "$target_version"
                echo "Switched to $target_version"
            else
                local branch
                branch=$(git symbolic-ref --short HEAD 2>/dev/null || echo "")
                if [[ -z "$branch" ]]; then
                    echo "Detached HEAD (pinned to a version tag)."
                    echo "Run 'arc update --version TAG' to switch versions,"
                    echo "or 'git checkout main' in $ARC_HOME to track latest."
                    return 0
                fi
                git pull --quiet origin "$branch"
            fi

            local after
            after=$(git rev-parse HEAD)

            if [[ "$before" == "$after" ]]; then
                echo "Already up to date. (arc v${ARC_VERSION})"
            else
                local count
                count=$(git rev-list --count "$before".."$after" 2>/dev/null || echo "?")
                echo "Updated ($count new commits)"
                echo ""
                git --no-pager log --oneline "$before".."$after"
            fi
        }
        arc_update "$@"
        ;;
    version|--version|-v)
        echo "arc v${ARC_VERSION}"
        ;;
    help|--help|-h)
        usage
        ;;
    *)
        echo "Unknown command: $COMMAND" >&2
        echo "Run 'arc help' for usage." >&2
        exit 1
        ;;
esac
