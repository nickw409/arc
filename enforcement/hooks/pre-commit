#!/usr/bin/env bash
#
# Pre-commit hook: Enforce file boundaries based on branch context
#
# Install: arc init (installs hooks automatically)

set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

log_error() { echo -e "${RED}[BLOCKED]${NC} $1" >&2; }
log_warn() { echo -e "${YELLOW}[WARNING]${NC} $1" >&2; }
log_ok() { echo -e "${GREEN}[OK]${NC} $1"; }

# Get current branch
BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "unknown")

# Determine context from branch name or environment
determine_context() {
    # Check environment variable first (set by automation scripts)
    if [[ -n "${AGENT_CONTEXT:-}" ]]; then
        echo "$AGENT_CONTEXT"
        return
    fi

    # Infer from branch name
    case "$BRANCH" in
        phase-*-qa|*/phase-*-qa)
            echo "qa"
            ;;
        phase-*|*/phase-*)
            echo "impl"
            ;;
        develop)
            echo "coord"
            ;;
        main)
            echo "human"
            ;;
        *)
            echo "unknown"
            ;;
    esac
}

CONTEXT=$(determine_context)

# Get list of staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)

if [[ -z "$STAGED_FILES" ]]; then
    exit 0
fi

# Define allowed paths per context
declare -A ALLOWED_PATHS
declare -A FORBIDDEN_PATHS

# QA context can only touch tests/qa/ and coordination files
ALLOWED_PATHS[qa]="^tests/qa/|^\.claude/coordination/qa/"
FORBIDDEN_PATHS[qa]="^src/|^tests/(?!qa/)"

# Implementation context can touch src/ and tests/ but NOT tests/qa/
ALLOWED_PATHS[impl]="^src/|^tests/(?!qa/)|^Cargo\.|^\.claude/coordination/phases/"
FORBIDDEN_PATHS[impl]="^tests/qa/"

# Coordination context can touch coordination files only
ALLOWED_PATHS[coord]="^\.claude/coordination/|^\.claude/project\.json"
FORBIDDEN_PATHS[coord]="^src/|^tests/"

# Human can touch anything
ALLOWED_PATHS[human]=".*"
FORBIDDEN_PATHS[human]=""

VIOLATIONS=()
WARNINGS=()

check_file() {
    local file="$1"
    local ctx="$2"

    local forbidden="${FORBIDDEN_PATHS[$ctx]:-}"
    local allowed="${ALLOWED_PATHS[$ctx]:-}"

    # Check forbidden paths first
    if [[ -n "$forbidden" ]] && echo "$file" | grep -qE "$forbidden"; then
        VIOLATIONS+=("$file (forbidden for $ctx context)")
        return 1
    fi

    # Check if in allowed paths
    if [[ -n "$allowed" ]] && ! echo "$file" | grep -qE "$allowed"; then
        WARNINGS+=("$file (not in allowed paths for $ctx context)")
    fi

    return 0
}

# Check each staged file
for file in $STAGED_FILES; do
    check_file "$file" "$CONTEXT" || true
done

# Report results
if [[ ${#VIOLATIONS[@]} -gt 0 ]]; then
    log_error "File boundary violations detected!"
    echo ""
    echo "Context: $CONTEXT"
    echo "Branch: $BRANCH"
    echo ""
    echo "Forbidden files:"
    for v in "${VIOLATIONS[@]}"; do
        echo "  ✗ $v"
    done
    echo ""
    echo "This commit has been BLOCKED."
    echo ""
    echo "If you believe this is an error:"
    echo "  1. Check you're on the correct branch"
    echo "  2. Set AGENT_CONTEXT if context detection is wrong"
    echo "  3. Contact human operator for override"
    echo ""
    exit 1
fi

if [[ ${#WARNINGS[@]} -gt 0 ]]; then
    log_warn "Files outside normal working area:"
    for w in "${WARNINGS[@]}"; do
        echo "  ⚠ $w"
    done
    echo ""
fi

log_ok "File boundary check passed for context: $CONTEXT"
exit 0
